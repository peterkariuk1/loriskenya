rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /newsletter_emails/{emailId} {
      allow read, delete: if false;

      allow create: if isValidSubscription()
        && emailId == request.resource.data.emailNormalized;

      // Re-submitting the same normalized email is idempotent. The email
      // identity and origin cannot be changed by a public client.
      allow update: if isValidSubscription()
        && emailId == request.resource.data.emailNormalized
        && resource.data.emailNormalized == request.resource.data.emailNormalized
        && resource.data.email == request.resource.data.email
        && resource.data.source == request.resource.data.source;

      function isValidSubscription() {
        return request.resource.data.keys().hasOnly([
            'email',
            'emailNormalized',
            'subscribedAt',
            'source',
            'status'
          ])
          && request.resource.data.email is string
          && request.resource.data.emailNormalized is string
          && request.resource.data.email == request.resource.data.emailNormalized
          && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
          && request.resource.data.email.size() <= 254
          && request.resource.data.emailNormalized.size() <= 254
          && request.resource.data.source == 'website_footer'
          && request.resource.data.status == 'subscribed'
          && request.resource.data.subscribedAt == request.time;
      }
    }
  }
}
